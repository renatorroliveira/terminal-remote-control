{
    "name": "@trc/desktop",
    "productName": "Terminal Remote Control",
    "version": "0.2.0",
    "description": "Accessible terminal sessions that live on your hosts",
    "author": "Renato Oliveira",
    "private": true,
    "type": "module",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "typecheck": "tsc -p tsconfig.main.json --pretty false && tsc -p tsconfig.preload.json --pretty false && tsc -p tsconfig.connection-host.json --pretty false && tsc -p tsconfig.renderer.json --pretty false && tsc -p tsconfig.test.json --pretty false",
        "build:test": "TRC_TEST_BUILD=1 electron-vite build",
        "dist": "electron-vite build && electron-builder --mac --publish never",
        "test:e2e": "pnpm build:test && playwright test",
        "i18n": "node ../../tools/i18n/i18n.ts",
        "i18n:check": "node ../../tools/i18n/i18n.ts --check"
    },
    "dependencies": {
        "@trc/protocol": "workspace:*",
        "@xterm/addon-unicode-graphemes": "0.4.0",
        "@xterm/addon-webgl": "0.19.0",
        "@xterm/xterm": "6.0.0",
        "react": "19.3.1",
        "react-aria-components": "1.22.1",
        "react-dom": "19.3.1",
        "react-intl": "12.1.7",
        "zod": "4.6.7",
        "zustand": "5.1.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@formatjs/cli": "6.18.2",
        "@playwright/test": "1.65.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "axe-core": "4.14.0",
        "colorjs.io": "0.7.1",
        "electron": "45.3.1",
        "electron-builder": "26.18.0",
        "electron-vite": "6.0.0",
        "vite": "8.3.8",
        "vitest-browser-react": "2.3.0"
    }
}
